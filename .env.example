# BLACKBOX X — Environment Configuration Template
# Server-side API key for Google Gemini (Risk Committee / CRO Briefing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side API key for Featherless LLM (BLACKBOX AI Research Assistant)
# OpenAI-compatible base URL: https://api.featherless.ai/v1
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Server-side API key for Tavily Web Search (Live External Financial News Grounding)
TAVILY_API_KEY=

# ============================================================
# SUPABASE PERSISTENCE — BLACKBOX X Research Storage Layer
# ============================================================

# Supabase project URL (safe to expose to client/browser)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose to client/browser — used with RLS)
VITE_SUPABASE_ANON_KEY=

# DANGER: Service role key — MUST REMAIN SERVER-SIDE ONLY
# NEVER place this key in React components, client bundles, or any browser code.
# NEVER commit actual key values to source control.
# Used exclusively by server/api/research/* endpoints.
SUPABASE_SERVICE_ROLE_KEY=
